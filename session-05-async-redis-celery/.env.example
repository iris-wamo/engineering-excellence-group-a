# PostgreSQL configuration
POSTGRES_USER=user
POSTGRES_PASSWORD=123456
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Host port Compose publishes Postgres on. If a native Postgres already owns 5432,
# set this and POSTGRES_PORT (and TEST_DATABASE_URL's port) to e.g. 15432.
# Containers always use postgres:5432 internally.
POSTGRES_HOST_PORT=5432
POSTGRES_DB=taskflow

# MongoDB configuration
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB_NAME=taskflow_imports

# Dedicated test database (used by pytest integration test suite)
TEST_DATABASE_URL=postgresql+asyncpg://user:123456@localhost:5432/taskflow_test

# Redis (Compose overrides localhost with the redis service hostname)
REDIS_URL=redis://localhost:6379/0
# Host port Compose publishes Redis on. If 6379 is taken, set this to e.g. 16379 and
# use the same port in REDIS_URL and the CELERY_* URLs below.
REDIS_HOST_PORT=6379

# Celery (broker on Redis DB 1, results on Redis DB 2; Compose overrides the host)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# Hard kill after CELERY_TASK_TIME_LIMIT seconds; SoftTimeLimitExceeded is raised earlier
CELERY_TASK_TIME_LIMIT=60
CELERY_TASK_SOFT_TIME_LIMIT=50

# JWT authentication
# Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-random-secret-of-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Password used for demo accounts created by `make seed-rbac` (development only)
SEED_USER_PASSWORD=Password123!

# Application environment
APP_ENV=development
