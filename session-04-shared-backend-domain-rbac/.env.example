# PostgreSQL configuration
POSTGRES_USER=user
POSTGRES_PASSWORD=123456
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=taskflow

# MongoDB configuration
MONGO_HOST: str = Field("localhost", alias="MONGO_HOST")
MONGO_PORT: int = Field(27017, alias="MONGO_PORT")
MONGO_DB_NAME: str = Field("taskflow_imports", alias="MONGO_DB_NAME")
MONGO_URI: str | None = None

# Dedicated test database (used by pytest integration test suite)
TEST_DATABASE_URL=postgresql+asyncpg://user:123456@localhost:5432/taskflow_test

# Application environment
APP_ENV=development
